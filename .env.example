# Environment Variables Example (aligned with deploy/ci workflows)

# Next.js Base Path
NEXT_PUBLIC_BASE_PATH=/silent-shutter

# Supabase Connection
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=photos
NEXT_PUBLIC_STORAGE_URL=your_public_storage_url

# Environment Switch
# Set to 'supabase' to use Supabase (recommended for production/preview)
DB_STRATEGY=supabase

# Keep local variables for reference if needed
# LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/photographer_site
