# Environment Variables Example

# Database Connection (Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local Database (PostgreSQL)
LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/photographer_site

# Storage (Vercel Blob or S3)
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_ENDPOINT=your_endpoint
NEXT_PUBLIC_STORAGE_URL=your_public_storage_url

# Environment Switch
# Set to 'local' to use local PostgreSQL, 'supabase' to use Supabase
DB_STRATEGY=local
